{
  "name": "optc-nakama",
  "version": "0.5.73",
  "private": true,
  "description": "Global OPTC için yerel Windows takım ve kutu yardımcısı",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/test-recognition-desktop.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "package:portable": "npm run build && electron-builder --win portable",
    "recognition:build": "node scripts/build-recognition.mjs",
    "catalog:update": "node scripts/update-catalog.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "json5": "^2.2.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.optc.nakama",
    "productName": "OPTC Nakama",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE.md",
      "README.md",
      "docs/UPSTREAM-LICENSE.md",
      "docs/HCI-DESIGN.md"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "OPTC-Nakama-${version}.exe"
    },
    "asarUnpack": [
      "electron/windows-ocr.ps1",
      "node_modules/@img/**/*",
      "node_modules/sharp/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/is-url/**/*",
      "node_modules/wasm-feature-detect/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/@tesseract.js-data/eng/**/*"
    ]
  }
}
